---
import { site } from '../data/site';

interface Props {
  /** Open the menu upwards (in the footer). */
  up?: boolean;
  current?: string;
}
const { up = false, current = 'en' } = Astro.props;
const languages = site.languages;
const active = languages.find((l) => l.code === current) ?? languages[0];
---

{
  languages.length > 1 && (
    <details class="lang">
      <summary class="lang__button t-nav">
        <img src="/icons/globe.svg" width="18" height="18" alt="" />
        <span>{active.label}</span>
        <img src="/icons/chevron-down.svg" width="16" height="16" alt="" />
      </summary>
      <div class:list={['lang__menu', { 'lang__menu--up': up }]}>
        {languages.map((l) => (
          <a
            class="lang__item t-nav"
            href={l.href}
            hreflang={l.code}
            lang={l.code}
            aria-current={l.code === active.code ? 'true' : undefined}
          >
            {l.label}
            {l.code === active.code && <img src="/icons/check.svg" width="16" height="16" alt="" />}
          </a>
        ))}
      </div>
    </details>
  )
}
