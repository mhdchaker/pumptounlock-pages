---
import '@fontsource-variable/archivo/wdth.css';
import '../styles/global.css';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
import { getPosts } from '../data/posts';

interface Props {
  title: string;
  description: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  jsonLd?: object[];
}
const { title, description, type = 'website', noindex = false, jsonLd = [] } = Astro.props;
const canonical = new URL(Astro.url.pathname, site.url).href;
const hasPosts = (await getPosts()).length > 0;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    {site.googleSiteVerification && <meta name="google-site-verification" content={site.googleSiteVerification} />}
    <meta name="theme-color" content="#f7f5f0" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {hasPosts && <link rel="alternate" type="application/rss+xml" title={`${site.name} Blog`} href="/rss.xml" />}
    <slot name="head" />
    {jsonLd.map((data) => <script is:inline type="application/ld+json" set:html={JSON.stringify(data)} />)}
  </head>
  <body>
    <slot />
    <Footer />
  </body>
</html>
