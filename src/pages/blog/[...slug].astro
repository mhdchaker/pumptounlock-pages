---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageTop from '../../components/PageTop.astro';
import Logo from '../../components/Logo.astro';
import AppStoreBadge from '../../components/AppStoreBadge.astro';
import { getPosts, longDate } from '../../data/posts';
import { site } from '../../data/site';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const url = new URL(`/blog/${post.id}/`, site.url).href;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: post.data.title,
    description: post.data.description,
    datePublished: post.data.date.toISOString(),
    // The day the facts were last checked counts as the last change, when it is the later date.
    ...(post.data.factsChecked && post.data.factsChecked > post.data.date
      ? { dateModified: post.data.factsChecked.toISOString() }
      : {}),
    mainEntityOfPage: url,
    ...(post.data.image ? { image: new URL(post.data.image, site.url).href } : {}),
    // The search data names an author only for a real person or the app (see site.blogAuthor).
    ...(site.blogAuthor.decided && site.blogAuthor.kind !== 'none' && post.data.author
      ? {
          author: {
            '@type': site.blogAuthor.kind === 'person' ? 'Person' : 'Organization',
            name: post.data.author,
          },
        }
      : {}),
    publisher: { '@type': 'Organization', name: site.name, url: site.url },
  },
];
---

<Base title={`${post.data.title} | PumpToUnlock`} description={post.data.description} type="article" jsonLd={jsonLd}>
  <PageTop
    title={post.data.title}
    byline={`By ${post.data.author}`}
    sub={longDate(post.data.date)}
    back={{ href: '/blog/', label: 'Blog' }}
  />
  <main class="content wrap">
    <div class="article-wrap">
      <article class="prose article">
        <Content />
      </article>
      <aside class="download-card">
        <div class="download-card__words">
          <Logo />
          <p class="t-small">{site.downloadLine}</p>
        </div>
        <AppStoreBadge />
      </aside>
    </div>
  </main>
</Base>
